#!/usr/bin/env sh
set -e

###############################################################################
# 1 — Secret scan (staged diff only)
###############################################################################
# Detect whether gitleaks is available (global install or yarn script)
if command -v gitleaks >/dev/null 2>&1; then
  GITLEAKS_CMD="gitleaks"
else
  # fall back to the yarn script you added with `yarn add -D @gitleaks/gitleaks`
  GITLEAKS_CMD="yarn gitleaks"
fi

echo "🔍  Running Gitleaks on staged changes…"
# --staged → only the index, so it’s fast; --redact hides the secret in output
$GITLEAKS_CMD protect --staged --redact --no-banner --log-level error --config .gitleaks.toml

###############################################################################
# 2 — Contracts build/lint (only if packages/contracts changed)
###############################################################################
STAGED_CHANGES=$(git diff --cached --name-only -- packages/contracts)

if [ -z "$STAGED_CHANGES" ]; then
  echo "✅  No changes in packages/contracts – skipping build."
else
  echo "🏗️   Building & linting contracts (because they changed)…"
  yarn workspace @chimera-monorepo/contracts build:sol
  yarn workspace @chimera-monorepo/contracts lint:fix
fi
