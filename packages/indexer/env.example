# RPC Endpoints (Optional - defaults to public RPCs)
# It's recommended to use your own RPC endpoints for better performance

# Ethereum
ETHEREUM_RPC_URL=https://eth.llamarpc.com

# Arbitrum
ARBITRUM_RPC_URL=https://arbitrum.llamarpc.com

# Optimism
OPTIMISM_RPC_URL=https://optimism.llamarpc.com

# Base
BASE_RPC_URL=https://base.llamarpc.com

# Database (Envio default)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/envio

# GraphQL API Port (default: 8080)
GRAPHQL_PORT=8080
