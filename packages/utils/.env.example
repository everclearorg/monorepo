# Betterstack Integration Test Configuration
# Copy this file to .env.local and fill in your actual values

# Your Betterstack API key (required for integration tests)
BETTERSTACK_API_KEY=your_api_key_here

# Email address for incident attribution (required for integration tests)  
BETTERSTACK_REQUESTER_EMAIL=your_email@example.com

# Set to true to enable integration tests, false to skip them
ENABLE_INTEGRATION_TESTS=false